    },
    {
      "name": "events",
      "label": "PTO events",
      "label_singular": "PTO event",
      "folder": "content/events",
      "create": true,
      "extension": "json",
      "format": "json",
      "slug": "{{year}}-{{month}}-{{day}}-{{slug}}",
      "summary": "{{title}} · {{start}}",
      "identifier_field": "title",
      "sortable_fields": [
        "start",
        "title"
      ],
      "fields": [
        {
          "name": "title",
          "label": "Event title",
          "widget": "string"
        },
        {
          "name": "start",
          "label": "Start date & time",
          "widget": "datetime",
          "date_format": "MM/DD/YYYY",
          "time_format": "h:mm A",
          "format": "YYYY-MM-DDTHH:mm:ssZ",
          "picker_utc": false,
          "hint": "Enter Magnolia, Texas time. For an all-day event, the calendar date you enter is used."
        },
        {
          "name": "end",
          "label": "End date & time (optional)",
          "widget": "datetime",
          "required": false,
          "format": "YYYY-MM-DDTHH:mm:ssZ",
          "picker_utc": false,
          "hint": "For an all-day event, the end date is the last included day."
        },
        {
          "name": "allDay",
          "label": "All-day event",
          "widget": "boolean",
          "default": false
        },
        {
          "name": "category",
          "label": "Event type",
          "widget": "select",
          "options": [
            "PTO event",
            "Fundraising",
            "Spirit Night",
            "Staff Appreciation",
            "Meeting"
          ],
          "default": "PTO event"
        },
        {
          "name": "location",
          "label": "Location (optional)",
          "widget": "string",
          "required": false
        },
        {
          "name": "description",
          "label": "Event details",
          "widget": "text"
        },
        {
          "name": "link",
          "label": "Optional link",
          "widget": "string",
          "required": false,
          "pattern": [
            "^https://[^\\s]+$",
            "Use a complete https:// link."
          ]
        },
        {
          "name": "linkLabel",
          "label": "Link button text",
          "widget": "string",
          "required": false
        },
        {
          "name": "published",
          "label": "Show on the website after publishing",
          "widget": "boolean",
          "default": true
        }
      ]
    },
    {
      "name": "news",
      "label": "News & announcements",
      "label_singular": "Announcement",
      "folder": "content/news",
      "create": true,
      "extension": "json",
      "format": "json",
      "slug": "{{year}}-{{month}}-{{day}}-{{slug}}",
      "summary": "{{title}}",
      "fields": [
        {
          "name": "title",
          "label": "Announcement title",
          "widget": "string"
        },
        {
          "name": "date",
          "label": "Announcement date",
          "widget": "datetime",
          "date_format": "MM/DD/YYYY",
          "time_format": false,
          "format": "YYYY-MM-DD"
        },
        {
          "name": "body",
          "label": "Announcement text",
          "widget": "text"
        },
        {
          "name": "image",
          "label": "Approved image (optional)",
          "widget": "image",
          "required": false
        },
        {
          "name": "imageAlt",
          "label": "Image description (accessibility)",
          "widget": "text",
          "required": false
        },
        {
          "name": "link",
          "label": "Optional link",
          "widget": "string",
          "required": false,
          "pattern": [
            "^https://[^\\s]+$",
            "Use a complete https:// link."
          ]
        },
        {
          "name": "linkLabel",
          "label": "Link button text",
          "widget": "string",
          "required": false
        },
        {
          "name": "published",
          "label": "Show on the website after publishing",
          "widget": "boolean",
          "default": true
        }
      ]
    }
  ]
