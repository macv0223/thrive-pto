              "label": "Nav Events",
              "widget": "string"
            },
            {
              "name": "navVolunteer",
              "label": "Nav Volunteer",
              "widget": "string"
            },
            {
              "name": "navMembership",
              "label": "Nav Membership",
              "widget": "string"
            },
            {
              "name": "navSupport",
              "label": "Nav Support",
