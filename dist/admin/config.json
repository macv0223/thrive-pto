    {
      "name": "settings",
      "label": "Site settings & links",
      "files": [
        {
          "name": "settings",
          "label": "Branding, contact & links",
          "file": "content/settings.json",
          "fields": [
            {
              "name": "name",
              "label": "Name",
              "widget": "string"
            },
            {
              "name": "shortName",
              "label": "Short Name",
              "widget": "string"
            },
            {
              "name": "schoolYear",
              "label": "School Year",
              "widget": "string"
            },
            {
              "name": "email",
              "label": "Email",
              "widget": "string",
              "pattern": [
                "^[^\\s@<>]+@[^\\s@<>]+\\.[^\\s@<>]+$",
                "Enter a valid email address."
              ]
            },
            {
              "name": "logo",
              "label": "Logo",
              "widget": "image",
              "hint": "Upload an approved image. Use the image description field to describe meaningful content."
            },
            {
              "name": "schoolUrl",
              "label": "School Url",
              "widget": "string",
              "pattern": [
                "^https://[^\\s]+$",
                "Use a complete https:// link."
              ]
            },
            {
              "name": "membershipUrl",
              "label": "Membership Url",
              "widget": "string",
              "pattern": [
                "^https://[^\\s]+$",
                "Use a complete https:// link."
              ]
            },
            {
              "name": "storeUrl",
              "label": "Store Url",
              "widget": "string",
              "pattern": [
                "^https://[^\\s]+$",
                "Use a complete https:// link."
              ]
            },
